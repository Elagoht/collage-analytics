// A collage plugin that adds a privacy-friendly analytics snippet to every page's
// head — Plausible, Umami or GoatCounter, or Google Analytics 4 — in production and
// in static builds, with Do Not Track and consent respected before anything loads.
module github.com/Elagoht/collage-analytics

go 1.26

require github.com/Elagoht/collage v0.23.0
